# Hermes environment
# LLM backend: dario (Claude-subscription proxy) on dario.network, reachable at http://dario:3456.
# Hermes talks to it with the standard Anthropic SDK env vars.
ANTHROPIC_BASE_URL=http://dario:3456
# ANTHROPIC_API_KEY is appended below from infra/dario/dario.env (the shared DARIO_API_KEY).
ANTHROPIC_API_KEY=CHANGEME_same_as_dario_DARIO_API_KEY

# Remap the in-container hermes user to the host user so the data volume stays owned by uid/gid 1000.
HERMES_UID=1000
HERMES_GID=1000

# Note: the serve bind host/port are passed as flags in the quadlet (Exec=serve --host 0.0.0.0 --port 3000).
# Dashboard/gateway basic-auth (username + scrypt password_hash) lives in the hermes-data volume's
# config.yaml under dashboard.basic_auth — a non-loopback bind refuses to start without it.
