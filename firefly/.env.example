APP_ENV=production
APP_DEBUG=false
APP_URL=https://fin.youssefalhassan.com
# Laravel app encryption key. Generate with:
#   docker run --rm fireflyiii/core:latest php artisan key:generate --show
APP_KEY=CHANGEME_base64_laravel_app_key
APP_LOG_LEVEL=notice

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=CHANGEME_same_as_postgres_FIREFLY_DB_PASSWORD

# Trust all proxies (Traefik + Cloudflare chain)
TRUSTED_PROXIES=**

# Disable email (log only)
MAIL_MAILER=log

# Cache / session
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
