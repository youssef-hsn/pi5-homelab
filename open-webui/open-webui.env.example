# Open WebUI environment

# Public URL (used for OAuth redirects, shared-chat links, etc.)
WEBUI_URL=https://ai.youssefalhassan.com

# Signs session JWTs — must stay stable across restarts or all users get logged out.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGEME_openssl_rand_hex_32

# No local Ollama instance in this homelab — disable so Open WebUI doesn't try to reach one.
ENABLE_OLLAMA_API=false

# LLM backend: dario (Claude-subscription proxy) on dario.network, reachable at http://dario:3456.
# dario exposes an OpenAI-compatible surface at /v1, so Open WebUI's standard "OpenAI" connection works.
OPENAI_API_BASE_URLS=http://dario:3456/v1
# Shared DARIO_API_KEY from infra/dario/dario.env.
OPENAI_API_KEYS=CHANGEME_same_as_dario_DARIO_API_KEY
