# Open WebUI environment

# Public URL (used for OAuth redirects, shared-chat links, etc.)
WEBUI_URL=https://ai.youssefalhassan.com

# Signs session JWTs — must stay stable across restarts or all users get logged out.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGEME_openssl_rand_hex_32

# No local Ollama instance in this homelab — disable so Open WebUI doesn't try to reach one.
ENABLE_OLLAMA_API=false

# LLM backends, both on dario.network and both OpenAI-compatible at /v1. Open WebUI
# takes ';'-separated lists and index-matches URL[i] to key[i], so the two connections
# are independent — one being down just hides its models, it doesn't break the other.
#   [0] dario — Claude-subscription proxy  -> http://dario:3456  (key: DARIO_API_KEY)
#   [1] codex — ChatGPT-subscription proxy -> http://codex:8787  (key: CODEX_PROXY_API_KEY)
OPENAI_API_BASE_URLS=http://dario:3456/v1;http://codex:8787/v1
# [0] = same as dario's DARIO_API_KEY; [1] = same as codex's CODEX_PROXY_API_KEY.
OPENAI_API_KEYS=CHANGEME_same_as_dario_DARIO_API_KEY;CHANGEME_same_as_codex_CODEX_PROXY_API_KEY
