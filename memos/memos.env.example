# Memos environment — https://memos.youssefalhassan.com

MEMOS_MODE=prod
MEMOS_ADDR=0.0.0.0
MEMOS_PORT=5230

# Use the shared PostgreSQL server (reached at postgres:5432 on postgres.network).
# Password must match postgres/.env MEMOS_DB_PASSWORD (created by initdb/03-memos.sh).
MEMOS_DRIVER=postgres
MEMOS_DSN=postgresql://memos:CHANGEME_same_as_postgres_MEMOS_DB_PASSWORD@postgres:5432/memos?sslmode=disable
