http:
  middlewares:
    sablier-jellyfin:
      plugin:
        sablier:
          sablierUrl: "http://127.0.0.1:10000"
          names: "jellyfin"
          # Jellyfin takes up to 2 minutes to fully start
          sessionDuration: "20m"
          dynamic:
            displayName: "Jellyfin"
            theme: "hacker-terminal"
            refreshFrequency: "5s"
            showDetails: true

    sablier-vaultwarden:
      plugin:
        sablier:
          sablierUrl: "http://127.0.0.1:10000"
          names: "vaultwarden"
          sessionDuration: "5m"
          dynamic:
            displayName: "VaultWarden"
            theme: "hacker-terminal"
            refreshFrequency: "3s"
            showDetails: true

