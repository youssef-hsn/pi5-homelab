# Odysseus core config. Full option reference: upstream .env.example
# (https://github.com/pewdiepie-archdaemon/odysseus/blob/main/.env.example)

AUTH_ENABLED=true
SECURE_COOKIES=true
ALLOWED_ORIGINS=https://odysseus.youssefalhassan.com
PUID=1000
PGID=1000

# ODYSSEUS_ADMIN_PASSWORD left unset on purpose — Odysseus generates one on
# first boot and prints it to `journalctl --user -u odysseus`.

# ------------------------------------------------------------------
# LLM backend — NOT CONFIGURED YET.
# Odysseus only speaks OpenAI-compatible / Ollama / LM Studio wire formats
# (no Anthropic support), so pick ONE:
#   OPENAI_API_KEY=sk-...                                  # OpenAI
#   OLLAMA_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the Pi
#   LLM_HOST=<hostname-of-a-remote-llama.cpp/vLLM/LM-Studio-box>
# See docs/services.md for details.
# ------------------------------------------------------------------
